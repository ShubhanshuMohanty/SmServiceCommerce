
<style>
    /* Custom CSS for Neumorphism and specific styles not covered by Bootstrap */
    :root {
        --bs-primary: #3B82F6;
        --bs-secondary: #10B981;
        --bs-light-bg: #f0f2f5;
        --bs-gray-900: #1a202c; /* Approximating Tailwind's gray-900 */
        --bs-gray-700: #4a5568; /* Approximating Tailwind's gray-700 */
        --bs-gray-600: #718096; /* Approximating Tailwind's gray-600 */
        --bs-gray-500: #a0aec0; /* Approximating Tailwind's gray-500 */
        --bs-gray-400: #cbd5e0; /* Approximating Tailwind's gray-400 */
    }

    body {
        background-color: var(--bs-light-bg);
        font-family: sans-serif; /* Bootstrap's default font-sans */
    }

    .neumorphic {
        background: var(--bs-light-bg);
        box-shadow: 8px 8px 16px #d1d5db, -8px -8px 16px #ffffff;
        border-radius: 0.5rem; /* Equivalent to Bootstrap's rounded */
    }

    .neumorphic-inset {
        background: var(--bs-light-bg);
        box-shadow: inset 4px 4px 8px #d1d5db, inset -4px -4px 8px #ffffff;
        border-radius: 0.5rem; /* Equivalent to Bootstrap's rounded */
    }

    .neumorphic-hover:hover {
        box-shadow: 12px 12px 24px #d1d5db, -12px -12px 24px #ffffff;
        transform: translateY(-2px);
    }

    .rounded-button {
        border-radius: 8px !important; /* Custom border-radius for buttons */
    }

    .hero-bg {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(16, 185, 129, 0.1) 100%);
    }

    .text-primary-custom {
        color: var(--bs-primary) !important;
    }

    .text-secondary-custom {
        color: var(--bs-secondary) !important;
    }

    /* Specific background opacities */
    .bg-primary-10 {
        background-color: rgba(59, 130, 246, 0.1) !important;
    }

    .bg-secondary-10 {
        background-color: rgba(16, 185, 129, 0.1) !important;
    }

    .bg-yellow-500-10 {
        background-color: rgba(245, 158, 11, 0.1) !important; /* Tailwind yellow-500 */
    }

    .bg-purple-500-10 {
        background-color: rgba(168, 85, 247, 0.1) !important; /* Tailwind purple-500 */
    }

    .bg-green-500-10 {
        background-color: rgba(34, 197, 94, 0.1) !important; /* Tailwind green-500 */
    }

    .bg-blue-500-10 {
        background-color: rgba(59, 130, 246, 0.1) !important; /* Tailwind blue-500 */
    }

    /* Override Bootstrap's default active/focus states for neumorphic inputs if needed */
    .neumorphic-inset select:focus,
    .neumorphic-inset input:focus {
        box-shadow: none !important;
        border-color: transparent !important;
    }

    /* Adjustments for Bootstrap's default spacing if it differs from Tailwind */
    .mb-6 {
        margin-bottom: 1.5rem !important;
    }
    /* Custom margin to match Tailwind's mb-6 */
    .mb-8 {
        margin-bottom: 2rem !important;
    }
    /* Custom margin to match Tailwind's mb-8 */
    .leading-tight {
        line-height: 1.25 !important;
    }
    /* Custom line-height */
    .leading-relaxed {
        line-height: 1.625 !important;
    }
    /* Custom line-height */
    /* Style for icon backgrounds */
    .icon-background {
        width: 3rem; /* Adjust size as needed */
        height: 3rem; /* Adjust size as needed */
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem auto; /* Center horizontally and add margin below */
    }

        .icon-background > i {
            font-size: 1.5rem; /* Adjust icon size as needed */
        }
</style>



