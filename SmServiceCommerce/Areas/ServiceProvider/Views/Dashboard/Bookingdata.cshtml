@model List<Booking>

<div class="container my-4">
    <div class="row g-4">

        <!-- CARD 1 -->
        @foreach(var bookingdata in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card service-card p-3 position-relative h-100" style="border-radius: 1rem;">
                    <div class="d-flex align-items-start gap-3 mt-4">
                        @* <div class="profile-circle me-3">A</div> *@
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between flex-wrap">
                                <h5 class="mb-1 fw-semibold me-2">@bookingdata.User.Name</h5>
                                @if (bookingdata.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark rounded-pill">New Request</span>
                                }
                                else if (bookingdata.Status == "Confirmed")
                                {
                                    <span class="badge bg-success text-white rounded-pill">Accepted</span>
                                }
                                else if (bookingdata.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger text-white rounded-pill">Cancelled</span>
                                }
                            </div>
                            <div class="text-muted small mb-1">
                                <i class="fas fa-calendar-alt me-1"></i> @bookingdata.BookingDate
                                <span class="mx-2">|</span>
                                <i class="fas fa-clock me-1"></i> @bookingdata.BookingTime
                            </div>
                            <div class="text-muted small mb-2">
                                <i class="fas fa-map-marker-alt me-1"></i> @bookingdata.User.City, @bookingdata.User.State
                            </div>
                            <p class="mb-2">@bookingdata.Notes</p>
                            @if(bookingdata.Status=="Pending")
                            {
                                <div>
                                    <button class="btn btn-success btn-sm rounded-pill px-4 me-2 shadow-sm">
                                        <a asp-controller="Dashboard" asp-action="BookingAccept" asp-route-id="@bookingdata.Id">
                                            Accept
                                        </a> 
                                    </button>
                                    <button onclick="Delete('/ServiceProvider/Dashboard/BookingCancel/@bookingdata.Id')" class="btn btn-outline-danger btn-sm rounded-pill px-4 shadow-sm">Decline</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        
    </div>
</div>

@section Scripts {
    <script src="~/js/util.js"></script>
}